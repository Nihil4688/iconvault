{
  "name": "iconvault-server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "node scripts/patch-fantasticon.js",
    "backup:db": "cross-env tsx src/scripts/backup-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test tests/db/*.db.test.ts",
    "cutover:drop-legacy": "cross-env tsx src/scripts/drop-legacy-sprites.ts",
    "seed:demo": "cross-env tsx src/scripts/seed-demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fantasticon": "^4.1.0",
    "fflate": "^0.8.3",
    "jose": "^5.10.0",
    "jsdom": "^26.1.0",
    "mongoose": "^9.7.4",
    "multer": "^2.4.0",
    "opentype.js": "^2.0.0",
    "svgo": "^4.1.0",
    "wawoff2": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.1.0",
    "@types/opentype.js": "^1.3.10",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
