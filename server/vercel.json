{
  "version": 2,
  "builds": [
    {
      "src": "src/api.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/ttf2woff2/jssrc/ttf2woff2.wasm",
          "node_modules/fantasticon/templates/*.hbs"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api.ts"
    }
  ]
}
