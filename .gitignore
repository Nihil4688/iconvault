# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.*
!.env.example

# TypeScript build artifacts emitted next to sources (server tsc with
# no outDir writes .js/.d.ts alongside .ts). Scoped to server/src to
# avoid clobbering real .js configs in the client.
server/src/**/*.js
server/src/**/*.js.map
server/src/**/*.d.ts
server/src/**/*.d.ts.map
server/src/types/**/*.d.ts
!server/src/types/wawoff2.d.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# One-off audit / scratch output (e.g. ripgrep dumps from local code-audit runs)
audit-out*.txt
scratch-*.txt

# Captured linter / typechecker output
client/lint.log
client/tsc.log
server/tsc.log

# Local database backups (contain user emails and sprite data)
backups/

# Misc local tooling
.claude/
.vercel
coverage
*.tsbuildinfo
