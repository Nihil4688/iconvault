{
  "name": "iconvault-mcp",
  "displayName": "IconVault MCP",
  "description": "Use IconVault projects, folders, and SVG icons from MCP-compatible AI tools in VS Code.",
  "publisher": "nihil4688",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nihil4688/iconvault.git"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:iconvault.updateToken"
  ],
  "main": "./extension.cjs",
  "scripts": {
    "test": "npm run compile && node --test",
    "compile": "esbuild ../bin/iconvault-mcp.mjs --bundle --platform=node --format=esm --target=node18 --outfile=dist/iconvault-mcp.mjs",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "iconvault.updateToken",
        "title": "IconVault MCP: Update Personal API Token"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "iconvault.mcp",
        "label": "IconVault"
      }
    ],
    "configuration": {
      "title": "IconVault MCP",
      "properties": {
        "iconvault.serverUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Base URL of your IconVault API. The extension prompts for it on first use; remote servers must use HTTPS."
        },
        "iconvault.allowedFileRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Optional absolute directories from which IconVault MCP may read or download SVG files. File access is disabled unless you explicitly add trusted directories."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0"
  }
}
