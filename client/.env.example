# Copy this file to .env. Values starting with VITE_ are baked in at build time, so rebuild after changing them.

# Optional. API base URL (default http://localhost:5000).
VITE_API_URL=http://localhost:5000

# Google sign-in (optional). Same value as GOOGLE_CLIENT_ID in server/.env.
VITE_GOOGLE_CLIENT_ID=

# Microsoft sign-in (optional). Same values as MS_CLIENT_ID / MS_TENANT_ID in server/.env.
# Leave the tenant empty to use "common" (any account).
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=
